@import '../../styles/community-card.wxss';

.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
  overflow: hidden;
}

.detail-scroll {
  flex: 1;
  height: 0;
  padding-top: 8rpx;
}

.content-blocks {
  margin-top: 20rpx;
}

.favorite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 88%;
  margin: 32rpx auto 0;
  padding: 26rpx 0;
  background: #ffffff;
  border: 2rpx solid #28b446;
  border-radius: 24rpx;
  color: #28b446;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.favorite-btn-icon {
  font-size: 34rpx;
  line-height: 1;
}

.favorite-btn--active {
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(40, 180, 70, 0.28);
}

.favorite-btn--press {
  transform: scale(0.98);
  opacity: 0.88;
}

.comment-empty {
  margin: 0 28rpx 24rpx;
  text-align: center;
  color: #bbbbbb;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.comment-list {
  padding: 0 28rpx;
}

.comment-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.comment-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d8f3dc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  margin-right: 12rpx;
}

.comment-main {
  max-width: 75%;
  min-width: 0;
}

.comment-main--self,
.comment-main--other {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.comment-author {
  font-size: 22rpx;
  color: #bbbbbb;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.comment-bubble {
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
}

.comment-bubble--other {
  background: #f0f0f0;
  color: #444444;
  border-bottom-left-radius: 6rpx;
}

.comment-bubble--self {
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  color: #ffffff;
  border-bottom-left-radius: 6rpx;
}

.scroll-bottom {
  height: 160rpx;
}

.input-panel {
  flex-shrink: 0;
  padding: 16rpx 28rpx 20rpx;
  background: #f7f8fa;
  border-top: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.input-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 20rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(40, 180, 70, 0.06);
  box-sizing: border-box;
}

.comment-input {
  flex: 1;
  min-height: 72rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border: 2rpx solid #e8ece8;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  box-sizing: border-box;
}

.input-placeholder {
  color: #bbbbbb;
  font-size: 28rpx;
}

.send-btn {
  flex-shrink: 0;
  min-width: 120rpx;
  padding: 18rpx 28rpx;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  border-radius: 24rpx;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 6rpx 20rpx rgba(40, 180, 70, 0.28);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.send-btn--press {
  transform: scale(0.97);
  opacity: 0.92;
}

.send-btn--disabled {
  background: #d0d5d0;
  color: #ffffff;
  box-shadow: none;
}
