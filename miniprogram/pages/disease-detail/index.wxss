@import '../../styles/community-card.wxss';

.sub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.sub-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding: 8rpx 0 32rpx;
}

.detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}

.detail-meta {
  display: block;
  margin-top: 12rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.55;
}

.section-heading {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.5;
}

.detail-content {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.75;
}

.favorite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 88%;
  margin: 32rpx auto 0;
  padding: 26rpx 0;
  background: #ffffff;
  border: 2rpx solid #28b446;
  border-radius: 24rpx;
  color: #28b446;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
}

.favorite-btn--active {
  background: #e8f5e9;
}

.favorite-btn--press {
  opacity: 0.88;
  transform: scale(0.98);
}

.favorite-btn-icon {
  font-size: 34rpx;
  line-height: 1;
}
