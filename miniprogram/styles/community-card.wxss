/* 社区帖子卡片与板块（与识别页 section-card 统一） */
.section-card {
  margin: 0 28rpx 28rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(40, 180, 70, 0.06);
  box-sizing: border-box;
}

.post-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.post-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}

.post-tags {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.tag-official,
.tag-science {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tag-official {
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  color: #ffffff;
}

.tag-science {
  background: #e8f5e9;
  color: #28b446;
}

.author-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.author-name {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
}

.post-summary {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  min-height: 36rpx;
}

.tag-pinned {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: #fff3e0;
  color: #e65100;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 8rpx;
  line-height: 1.4;
}

.post-cover {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fafbfa;
}

.post-cover-img {
  width: 100%;
  display: block;
  max-height: 480rpx;
}

.content-heading {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.5;
}

.content-heading:first-child {
  margin-top: 0;
}

.content-text {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.75;
  margin-top: 8rpx;
}

.content-list {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.75;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

.section-title-block {
  margin: 8rpx 28rpx 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.4;
}
