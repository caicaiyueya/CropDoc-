.chat-page { display: flex; flex-direction: column; height: 100vh; }
.messages { flex: 1; padding: 20rpx; }
.msg { max-width: 80%; padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 16rpx; line-height: 1.5; }
.msg.user { background: #d8f3dc; margin-left: auto; }
.msg.assistant { background: #fff; }
.input-bar { display: flex; gap: 16rpx; padding: 16rpx; background: #fff; border-top: 1px solid #eee; }
.input-bar input { flex: 1; background: #f5f5f5; padding: 12rpx 20rpx; border-radius: 8rpx; }
