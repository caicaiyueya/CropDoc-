@import '../../styles/community-card.wxss';

.sub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.sub-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding: 8rpx 0 32rpx;
}

.fav-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fav-icon {
  font-size: 32rpx;
  line-height: 1;
}

.fav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}

.fav-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.55;
}

.fav-card--press {
  opacity: 0.92;
  transform: scale(0.99);
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 80rpx 28rpx;
}
