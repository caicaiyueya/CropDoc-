@import '../../styles/community-card.wxss';

.sub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.sub-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding: 8rpx 0 32rpx;
}

.fav-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.fav-main {
  flex: 1;
  min-width: 0;
}

.fav-head {
  display: flex;
  align-items: flex-start;
}

.fav-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}

.fav-summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.fav-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.fav-meta,
.fav-author {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.fav-cover {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #fafbfa;
  border: 1rpx solid rgba(40, 180, 70, 0.08);
}

.fav-cover--disease {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: #f0f8f2;
}

.fav-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #cccccc;
  line-height: 1;
}

.fav-card--press {
  opacity: 0.92;
  transform: scale(0.99);
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 80rpx 28rpx;
}
