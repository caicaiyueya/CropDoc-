@import '../../styles/community-card.wxss';

.sub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.sub-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding: 8rpx 0 32rpx;
}

.record-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #fafbfa;
  border: 1rpx solid rgba(40, 180, 70, 0.08);
}

.record-thumb--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f5e9;
  font-size: 48rpx;
  line-height: 1;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}

.record-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.55;
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 80rpx 28rpx;
  line-height: 1.6;
}
