<view class="home">
  <!-- 顶部区域：Banner + 快捷功能 -->
  <view class="header-zone">
    <view class="hero-wrap">
      <view class="hero-static">
        <image class="hero-bg" src="/assets/images/hero-bg.png" mode="aspectFill" />
        <view class="hero-gradient"></view>
        <view class="hero-inner" style="padding-top: {{statusBarHeight + 12}}px;">
          <view class="hero-text-wrap">
            <text class="hero-title">欢迎使用云农智诊</text>
            <text class="hero-subtitle">AI助力智慧农业</text>
          </view>
        </view>
      </view>
      <view class="hero-wave"></view>
    </view>

    <view class="quick-card">
      <view class="quick-grid">
        <view
          class="quick-item"
          wx:for="{{quickMenus}}"
          wx:key="name"
          bindtap="goPage"
          data-path="{{item.path}}"
        >
          <view class="quick-icon-box">
            <view wx:if="{{item.iconType === 'chat'}}" class="quick-icon quick-icon--chat"></view>
            <text wx:else class="quick-emoji">{{item.icon}}</text>
          </view>
          <text class="quick-label">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 常见病害科普轮播 -->
  <view class="section-card">
    <view class="section-head" bindtap="goCommunity">
      <text class="section-title">常见病害科普</text>
      <text class="section-arrow">›</text>
    </view>
    <swiper
      wx:if="{{scienceSlides.length}}"
      class="science-swiper"
      indicator-dots
      indicator-color="rgba(40,180,70,0.25)"
      indicator-active-color="#28b446"
      autoplay
      circular
      interval="4000"
      duration="500"
    >
      <swiper-item wx:for="{{scienceSlides}}" wx:key="_id">
        <view class="science-slide" bindtap="goSciencePost" data-id="{{item._id}}">
          <image wx:if="{{item.coverUrl}}" class="science-img" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="science-placeholder" style="background: {{item.thumbBg}};">
            <text class="science-emoji">{{item.thumbEmoji}}</text>
          </view>
          <view class="science-mask">
            <text class="science-title">{{item.title}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="science-empty">暂无科普帖子，请到社区发布</view>
  </view>

  <!-- 今日农业资讯 -->
  <view class="section-card">
    <view class="section-head" bindtap="goNewsList">
      <text class="section-title">今日农业资讯</text>
      <text class="section-arrow">›</text>
    </view>
    <view class="news-list">
      <view
        class="news-item"
        wx:for="{{latestNews}}"
        wx:key="_id"
        bindtap="goNews"
        data-id="{{item._id}}"
      >
        <view class="news-body">
          <text class="news-title">{{item.title}}</text>
          <text class="news-summary">{{item.summary}}</text>
          <text class="news-time">{{item.timeText}}</text>
        </view>
        <view class="news-thumb-wrap">
          <image wx:if="{{item.coverUrl}}" class="news-thumb" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="news-thumb news-thumb--placeholder">📰</view>
        </view>
      </view>
      <view wx:if="{{!latestNews.length}}" class="news-empty">暂无资讯</view>
    </view>
  </view>

  <view class="page-bottom"></view>
</view>
