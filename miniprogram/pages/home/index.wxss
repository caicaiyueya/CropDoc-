/* 设计稿色板 */
/* 主绿 #28B446  浅绿 #7ED957  背景 #F7F8FA  卡片 #FFFFFF */

.home {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 24rpx;
}

/* ===== 顶部整体区域 ===== */
.header-zone {
  position: relative;
  margin-bottom: 8rpx;
}

/* ===== 顶部 Hero ===== */
.hero-wrap {
  position: relative;
  margin-bottom: -32rpx;
}

.hero-static {
  position: relative;
  height: 392rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    160deg,
    rgba(26, 120, 60, 0.82) 0%,
    rgba(40, 180, 70, 0.72) 45%,
    rgba(80, 190, 90, 0.55) 100%
  );
  z-index: 1;
}

.hero-inner {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.hero-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

.hero-spacer {
  flex: 1;
}

.hero-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  text-align: center;
  padding: 4rpx 24rpx 104rpx;
  box-sizing: border-box;
}

.hero-title {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.45;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.95);
  font-size: 34rpx;
  line-height: 1.55;
  letter-spacing: 1rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.hero-wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 64rpx;
  background: #f7f8fa;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  z-index: 3;
}

/* ===== 四宫格悬浮卡片 ===== */
.quick-card {
  position: relative;
  z-index: 10;
  margin: 24rpx 28rpx 28rpx;
  padding: 36rpx 24rpx 32rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(40, 180, 70, 0.14);
  border: 1rpx solid rgba(40, 180, 70, 0.1);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.quick-icon-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(40, 180, 70, 0.28);
}

.quick-emoji {
  font-size: 54rpx;
  line-height: 1;
}

.quick-label {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.4;
  text-align: center;
  font-weight: 500;
}

/* AI问诊 - 对话气泡图标 */
.quick-icon {
  position: relative;
}

.quick-icon--chat {
  width: 54rpx;
  height: 42rpx;
  border: 4rpx solid #fff;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.quick-icon--chat::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 11rpx;
  width: 8rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 15rpx 0 0 #fff, 30rpx 0 0 #fff;
}

.quick-icon--chat::after {
  content: '';
  position: absolute;
  left: 12rpx;
  bottom: -11rpx;
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 13rpx solid #fff;
}

/* ===== 科普轮播 ===== */
.science-swiper {
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.science-slide {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.science-img {
  width: 100%;
  height: 100%;
}

.science-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.science-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.science-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx 28rpx 28rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

.science-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.science-empty {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  background: #f5f7f5;
  border-radius: 20rpx;
}

/* ===== 通用内容卡片 ===== */
.section-card {
  margin: 0 28rpx 28rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-card--compact {
  padding: 24rpx 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222222;
  line-height: 1.4;
}

.section-arrow {
  font-size: 40rpx;
  color: #cccccc;
  line-height: 1;
  font-weight: 300;
}

/* 资讯列表 - 左文右图 */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.news-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.news-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.news-body {
  flex: 1;
  min-width: 0;
}

.news-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #888;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.4;
}

.news-thumb-wrap {
  flex-shrink: 0;
}

.news-thumb {
  width: 180rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #eef5ee;
}

.news-thumb--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: linear-gradient(135deg, #d8f3dc, #b7e4c7);
}

.news-empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 32rpx 0;
}

.page-bottom {
  height: 140rpx;
}
