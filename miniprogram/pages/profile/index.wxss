@import '../../styles/community-card.wxss';

.tab-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.tab-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding-top: 8rpx;
}

/* ===== 用户信息卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  flex-shrink: 0;
  padding: 6rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #c8f0c8, #7ed957);
  box-shadow: 0 4rpx 16rpx rgba(40, 180, 70, 0.18);
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: #d8f3dc;
  box-sizing: border-box;
  display: block;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}

.user-phone {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.55;
}

/* ===== 功能列表 ===== */
.menu-card {
  padding: 8rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: opacity 0.15s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item--press {
  opacity: 0.72;
}

.menu-icon-box {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(40, 180, 70, 0.22);
}

.menu-icon {
  font-size: 36rpx;
  line-height: 1;
}

.menu-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.5;
}

.menu-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #cccccc;
  line-height: 1;
  font-weight: 300;
}

.page-bottom {
  height: 220rpx;
}
