@import '../../styles/community-card.wxss';

.tab-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.tab-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding-top: 8rpx;
}

.publish-btn {
  margin: 0 28rpx 28rpx;
  padding: 30rpx 0;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  border-radius: 24rpx;
  text-align: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(40, 180, 70, 0.28);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.publish-btn--press {
  transform: scale(0.98);
  opacity: 0.92;
}

.post-card--press {
  transform: scale(0.99);
  opacity: 0.96;
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 80rpx 28rpx;
  line-height: 1.6;
}

.page-bottom {
  height: 220rpx;
}
