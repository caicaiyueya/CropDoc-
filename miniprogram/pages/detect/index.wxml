<view class="detect-page">
  <scroll-view class="detect-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 顶部导航 -->
  <sub-page-header
    title="病虫害识别"
    statusBarHeight="{{statusBarHeight}}"
    headerMinHeight="{{headerMinHeight}}"
    bind:back="goBack"
  />

  <view class="page-body">
    <!-- 作物选择 -->
    <view class="section-card">
      <text class="section-title">请选择作物</text>
      <view class="crop-grid">
        <view
          class="crop-tag {{selectedCrop === item.key ? 'crop-tag--active' : ''}}"
          wx:for="{{crops}}"
          wx:key="key"
          bindtap="selectCrop"
          data-key="{{item.key}}"
          hover-class="crop-tag--press"
          hover-stay-time="120"
        >
          <text wx:if="{{selectedCrop === item.key}}" class="crop-check">✓</text>
          <text class="crop-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 图片上传 -->
    <view class="section-card">
      <text class="upload-tip">请拍照或从相册选择叶片图片</text>
      <text class="upload-hint">建议拍摄病害部位特写，识别更准确</text>

      <view class="preview-box">
        <image wx:if="{{imagePath}}" class="preview-img" src="{{imagePath}}" mode="aspectFit" />
        <view wx:else class="preview-placeholder">
          <view class="placeholder-icon">
            <text class="placeholder-camera">📷</text>
            <text class="placeholder-leaf">🌿</text>
          </view>
          <text class="placeholder-text">暂未选择图片</text>
        </view>
        <view wx:if="{{imagePath}}" class="preview-delete" catchtap="removeImage" hover-class="preview-delete--press" hover-stay-time="120">
          <text class="preview-delete-icon">×</text>
        </view>
      </view>

      <view class="action-row">
        <view class="action-btn action-btn--camera" bindtap="chooseImage" data-source="camera" hover-class="action-btn--press" hover-stay-time="120">
          <text class="action-icon">📷</text>
          <text class="action-label">拍照识别</text>
        </view>
        <view class="action-btn action-btn--album" bindtap="chooseImage" data-source="album" hover-class="action-btn--press" hover-stay-time="120">
          <text class="action-icon">🖼️</text>
          <text class="action-label">相册上传</text>
        </view>
      </view>
    </view>

    <!-- 开始识别 -->
    <view
      class="submit-btn {{canSubmit ? '' : 'submit-btn--disabled'}}"
      bindtap="startDetect"
      hover-class="{{canSubmit ? 'submit-btn--press' : ''}}"
      hover-stay-time="120"
    >
      <text wx:if="{{loading}}">识别中…</text>
      <text wx:else>开始识别</text>
    </view>
  </view>

  <view class="page-bottom"></view>
  </scroll-view>
</view>
