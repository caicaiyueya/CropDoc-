@import '../../styles/community-card.wxss';

.sub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.sub-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding: 8rpx 0 32rpx;
}

.about-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.about-version {
  display: block;
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 24rpx;
}

.about-desc {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.75;
  margin-bottom: 16rpx;
}

.about-foot {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #bbbbbb;
  line-height: 1.5;
}
