.result-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 24rpx;
}

/* ===== 内容区 ===== */
.page-body {
  padding: 32rpx 0 0;
}

.section-card {
  margin: 0 28rpx 28rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(40, 180, 70, 0.06);
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

/* 病害信息 */
.disease-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.disease-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.disease-meta-label {
  font-size: 28rpx;
  color: #444;
  line-height: 1.65;
}

.level-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.level-tag--mild {
  background: #e8f5e9;
  color: #2e7d32;
}

.level-tag--moderate {
  background: #fff3e0;
  color: #e65100;
}

.level-tag--severe {
  background: #ffebee;
  color: #c62828;
}

.confidence-text {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.55;
}

/* 图片对比 */
.compare-row {
  display: flex;
  gap: 20rpx;
}

.compare-col {
  flex: 1;
  min-width: 0;
}

.compare-label {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #888;
  line-height: 1.55;
  margin-bottom: 16rpx;
}

.compare-frame {
  width: 100%;
  height: 280rpx;
  border: 2rpx dashed #d8ddd8;
  border-radius: 20rpx;
  background: #fafbfa;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.compare-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.compare-empty {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  padding: 16rpx;
  line-height: 1.5;
}

/* 操作按钮 */
.action-area {
  margin: 8rpx 28rpx 0;
}

.btn-primary-action {
  width: 100%;
  padding: 30rpx 0;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  border-radius: 24rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(40, 180, 70, 0.28);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-primary-action--press {
  transform: scale(0.98);
  opacity: 0.92;
}

.btn-secondary-action {
  width: 88%;
  margin: 28rpx auto 0;
  padding: 26rpx 0;
  background: #ffffff;
  border: 2rpx solid #28b446;
  border-radius: 24rpx;
  text-align: center;
  color: #28b446;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-secondary-action--press {
  transform: scale(0.98);
  opacity: 0.88;
  background: #f0faf2;
}

.page-bottom {
  height: 48rpx;
}
