/* 各 Tab 页统一顶部导航（与 AI 问诊 / 识别页一致） */
.page-header {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  padding-bottom: 36rpx;
  box-sizing: border-box;
}

.page-header-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.page-header-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    160deg,
    rgba(26, 120, 60, 0.88) 0%,
    rgba(40, 180, 70, 0.78) 50%,
    rgba(80, 190, 90, 0.62) 100%
  );
  z-index: 1;
}

.page-header-inner {
  position: relative;
  z-index: 4;
  box-sizing: border-box;
  padding-bottom: 16rpx;
}

.page-header-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 24rpx 0 16rpx;
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.header-back--press {
  opacity: 0.75;
  transform: scale(0.94);
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 5rpx solid #fff;
  border-bottom: 5rpx solid #fff;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.header-side {
  width: 64rpx;
  flex-shrink: 0;
}

.page-header-title {
  flex: 1;
  text-align: center;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.45;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
}

.page-header-wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 32rpx;
  background: #f7f8fa;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  z-index: 2;
}
