/* 与首页统一的设计变量 */
.detect-page {
  height: 100vh;
  background: #f7f8fa;
}

.detect-scroll {
  height: 100vh;
}

/* ===== 内容区 ===== */
.page-body {
  position: relative;
  z-index: 1;
  padding: 32rpx 0 0;
}

.section-card {
  margin: 0 28rpx 28rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(40, 180, 70, 0.06);
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #28b446;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

/* 作物标签 */
.crop-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.crop-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  background: #f2f4f2;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.4;
  border: 1rpx solid #e8ece8;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.crop-tag--active {
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  color: #ffffff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(40, 180, 70, 0.25);
}

.crop-tag--press {
  transform: scale(0.96);
  opacity: 0.92;
}

.crop-check {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.crop-name {
  line-height: 1.4;
}

/* 上传区 */
.upload-tip {
  display: block;
  font-size: 29rpx;
  color: #888;
  line-height: 1.6;
}

.upload-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #bbb;
  line-height: 1.55;
  margin-bottom: 28rpx;
}

.preview-box {
  position: relative;
  width: 100%;
  height: 388rpx;
  border: 2rpx dashed #d8ddd8;
  border-radius: 24rpx;
  background: #fafbfa;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.preview-delete {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  z-index: 3;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.preview-delete--press {
  transform: scale(0.92);
  opacity: 0.85;
}

.preview-delete-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.placeholder-icon {
  position: relative;
  width: 128rpx;
  height: 96rpx;
  margin-bottom: 18rpx;
}

.placeholder-camera {
  position: absolute;
  left: 0;
  top: 0;
  font-size: 68rpx;
  line-height: 1;
  opacity: 0.55;
}

.placeholder-leaf {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 52rpx;
  line-height: 1;
  opacity: 0.65;
}

.placeholder-text {
  font-size: 27rpx;
  color: #bbb;
  line-height: 1.5;
}

/* 拍照 / 相册按钮 */
.action-row {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.action-btn--camera {
  background: linear-gradient(145deg, #2563eb, #3b82f6);
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.22);
}

.action-btn--album {
  background: linear-gradient(145deg, #ea580c, #f97316);
  box-shadow: 0 6rpx 16rpx rgba(234, 88, 12, 0.22);
}

.action-btn--press {
  transform: scale(0.97);
  opacity: 0.92;
}

.action-icon {
  font-size: 38rpx;
  line-height: 1;
}

.action-label {
  font-size: 29rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1.4;
}

/* 开始识别 - 深靛蓝，与主题绿区分 */
.submit-btn {
  margin: 12rpx 28rpx 0;
  padding: 30rpx 0;
  background: linear-gradient(145deg, #4338ca, #6366f1);
  border-radius: 24rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(67, 56, 202, 0.28);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.submit-btn--press {
  transform: scale(0.98);
  opacity: 0.92;
}

.submit-btn--disabled {
  background: #d0d5d0;
  color: #fff;
  box-shadow: none;
}

.page-bottom {
  height: 220rpx;
}
