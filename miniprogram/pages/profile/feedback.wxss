@import '../../styles/community-card.wxss';

.sub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.sub-page-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding: 8rpx 0 32rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #444444;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.field-label:not(:first-child) {
  margin-top: 28rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #e8ece8;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.65;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
}

.field-textarea {
  min-height: 280rpx;
  padding: 20rpx 24rpx;
}

.field-placeholder {
  color: #bbbbbb;
  font-size: 28rpx;
}

.submit-btn {
  margin: 0 28rpx;
  padding: 30rpx 0;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  border-radius: 24rpx;
  text-align: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(40, 180, 70, 0.28);
}

.submit-btn--press {
  transform: scale(0.98);
  opacity: 0.92;
}

.submit-btn--disabled {
  background: #d0d5d0;
  box-shadow: none;
}
