@import '../../styles/community-card.wxss';

.create-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
  overflow: hidden;
}

.create-scroll {
  flex: 1;
  height: 0;
}

.page-body {
  padding-top: 8rpx;
}

.form-card {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #444444;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.field-label:not(:first-child) {
  margin-top: 28rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #e8ece8;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.65;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
}

.field-textarea {
  min-height: 320rpx;
  padding: 20rpx 24rpx;
}

.field-placeholder {
  color: #bbbbbb;
  font-size: 28rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  background: #f2f4f2;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.4;
  border: 1rpx solid #e8ece8;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.type-tag--active {
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  color: #ffffff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(40, 180, 70, 0.25);
}

.type-tag--press {
  transform: scale(0.96);
  opacity: 0.92;
}

.type-check {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.submit-btn {
  margin: 0 28rpx;
  padding: 30rpx 0;
  background: linear-gradient(145deg, #28b446, #3ecf5a);
  border-radius: 24rpx;
  text-align: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(40, 180, 70, 0.28);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.submit-btn--press {
  transform: scale(0.98);
  opacity: 0.92;
}

.submit-btn--disabled {
  background: #d0d5d0;
  color: #ffffff;
  box-shadow: none;
}

.page-bottom {
  height: 48rpx;
}
