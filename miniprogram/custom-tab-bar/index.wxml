<view class="tab-bar" wx:if="{{!hidden}}">
  <view class="tab-bar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item--active' : ''}} {{item.center ? 'tab-item--center' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap {{item.center ? 'tab-icon-wrap--center' : ''}}">
        <text class="tab-emoji {{item.center ? 'tab-emoji--center' : ''}}">{{item.emoji}}</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
  <view class="tab-safe" style="height: {{safeBottom}}px;"></view>
</view>
